import Foundation

/// `DFRFoundation` —— Apple 的私有框架（DFR = "D* Function Row"，Touch Bar 的内部代号），
/// 位于 `/System/Library/PrivateFrameworks/DFRFoundation.framework`。
///
/// 我们**不链接**它（链接私有框架会在启动时直接 dyld 崩溃），而是运行时 `dlopen` + `dlsym`：
/// - 成功 → 可以使用增强能力；
/// - 失败（SIP / 系统版本变化 / 框架被移除）→ 自动降级，App 照常运行。
///
/// 已知符号（随系统版本变化，务必做空判断）：
/// - `DFRSystemModalShowsCloseBoxWhenFrontMost(BOOL)`：控制系统模态 Touch Bar 左侧是否显示关闭按钮。
enum DFRFoundationBridge {
    private static let candidatePaths = [
        "/System/Library/PrivateFrameworks/DFRFoundation.framework/Versions/A/DFRFoundation",
        "/System/Library/PrivateFrameworks/DFRFoundation.framework/DFRFoundation",
    ]

    private static let handle: UnsafeMutableRawPointer? = {
        for path in candidatePaths {
            if let handle = dlopen(path, RTLD_NOW) {
                Log.info("已加载 DFRFoundation：\(path)", log: Log.touchBar)
                return handle
            }
        }
        Log.debug("DFRFoundation 不可用（SIP / 系统版本差异），相关增强能力将自动降级", log: Log.touchBar)
        return nil
    }()

    static var isLoaded: Bool { handle != nil }

    /// 通用符号查找
    static func symbol<T>(_ name: String) -> T? {
        guard let handle, let pointer = dlsym(handle, name) else { return nil }
        return unsafeBitCast(pointer, to: T.self)
    }

    /// 隐藏 / 显示系统模态 Touch Bar 的关闭按钮。
    /// 隐藏后，注入出来的栏更像是原生 Control Strip 的一部分（BTT / Pock / MTMR 都这么做）。
    static func setSystemModalCloseBoxHidden(_ hidden: Bool) {
        typealias Fn = @convention(c) (Bool) -> Void
        guard let function: Fn = symbol("DFRSystemModalShowsCloseBoxWhenFrontMost") else {
            Log.debug("DFRSystemModalShowsCloseBoxWhenFrontMost 不可用，跳过", log: Log.touchBar)
            return
        }
        function(hidden)
    }
}
</file>

<file path="Sources/Stage3/PrivateTouchBar/ObjCRuntime.swift">
import Foundation
import ObjectiveC

/// 极薄的 Objective-C runtime 封装，专门用于调用私有 API。
///
/// 为什么不能直接 `performSelector:`：
/// 1. 我们要调用的是**类方法**，且最多带 3 个参数，`perform(_:with:with:)` 只支持 2 个；
/// 2. Swift 的 `performSelector` 系列在 ARC 下对返回值的处理很危险；
/// 3. arm64 上 `objc_msgSend` 必须通过**精确的函数类型**转换后再调用，否则寄存器错乱崩溃。
enum ObjCRuntime {
    /// `RTLD_DEFAULT` 是 `((void *)-2)` 宏，Swift 无法直接导入，这里手工构造
    private static let handleDefault = UnsafeMutableRawPointer(bitPattern: -2)

    static let msgSend: UnsafeMutableRawPointer? = dlsym(handleDefault, "objc_msgSend")

    /// 判断某个类上是否存在指定的**类方法**（比 `responds(to:)` 更精确，避免误判实例方法）
    static func classMethodExists(on cls: AnyClass, _ selector: Selector) -> Bool {
        class_getClassMethod(cls, selector) != nil
    }

    /// 类方法，无返回值，1 个对象参数
    static func sendVoid(_ cls: AnyClass, _ selector: Selector, _ arg1: AnyObject) {
        typealias Fn = @convention(c) (AnyClass, Selector, AnyObject) -> Void
        guard let raw = msgSend else { return }
        unsafeBitCast(raw, to: Fn.self)(cls, selector, arg1)
    }

    /// 类方法，无返回值，2 个对象参数
    static func sendVoid(_ cls: AnyClass, _ selector: Selector, _ arg1: AnyObject, _ arg2: AnyObject) {
        typealias Fn = @convention(c) (AnyClass, Selector, AnyObject, AnyObject) -> Void
        guard let raw = msgSend else { return }
        unsafeBitCast(raw, to: Fn.self)(cls, selector, arg1, arg2)
    }
}
