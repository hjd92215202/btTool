import AppKit

/// 右栏：头部（图标 + 名称 + 说明） + `NSTabView` 双标签页。
///
/// ```
/// ┌─────────────────────────────────────────────────────────────┐
/// │ 🧭 Safari浏览器                                              │
/// │    com.apple.Safari                                          │
/// ├─────────────────────────────────────────────────────────────┤
/// │  ┌─ 触控栏 ─┐┌─ 快捷键 ─┐                                    │
/// │  └───────────────────────────────────────────┘              │
/// │   （Tab1）按钮列表 + 编辑器                                  │
/// │   （Tab2）快捷键列表 + 编辑器                                │
/// └─────────────────────────────────────────────────────────────┘
/// ```
///
/// 为什么用 `NSTabView`：把「触控栏」和「键盘快捷键」两个独立的编辑流程隔开，
/// 避免它们在同一块区域里互相挤占垂直空间（这正是之前底部控件重叠的诱因之一）。
final class RuleDetailViewController: NSViewController {
    private var scope: RuleScope?

    private let iconView = NSImageView()
    private let nameLabel = NSTextField(labelWithString: "未选择")
    private let detailLabel = NSTextField(labelWithString: "")

    private let touchBarViewController = TouchBarItemsViewController()
    private let shortcutsViewController = ShortcutsViewController()

    // MARK: - 生命周期

    override func loadView() {
        view = NSView()
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        buildUI()
    }

    // MARK: - 对外接口（由左栏选中时调用）

    func showScope(id: String?) {
        let scope = id.map(RuleScope.init(id:))
        self.scope = scope
        reloadHeader()
        touchBarViewController.showScope(scope)
        shortcutsViewController.showScope(scope)
    }

    // MARK: - UI

    private func buildUI() {
        nameLabel.font = NSFont.systemFont(ofSize: 17, weight: .semibold)
        nameLabel.lineBreakMode = .byTruncatingTail
        detailLabel.font = NSFont.systemFont(ofSize: 11)
        detailLabel.textColor = .secondaryLabelColor
        detailLabel.lineBreakMode = .byTruncatingMiddle

        iconView.widthAnchor.constraint(equalToConstant: 36).isActive = true
        iconView.heightAnchor.constraint(equalToConstant: 36).isActive = true

        let texts = NSStackView(views: [nameLabel, detailLabel])
        texts.orientation = .vertical
        texts.alignment = .leading
        texts.spacing = 1

        let header = NSStackView(views: [iconView, texts])
        header.orientation = .horizontal
        header.alignment = .centerY
        header.spacing = Metrics.labelGap

        let tabView = NSTabView()
        tabView.tabViewType = .topTabsBezelBorder
        tabView.translatesAutoresizingMaskIntoConstraints = false

        let touchBarItem = NSTabViewItem(identifier: "touchBarTab")
        touchBarItem.label = "触控栏"
        touchBarItem.viewController = touchBarViewController
        tabView.addTabViewItem(touchBarItem)

        let shortcutsItem = NSTabViewItem(identifier: "shortcutsTab")
        shortcutsItem.label = "键盘快捷键"
        shortcutsItem.viewController = shortcutsViewController
        tabView.addTabViewItem(shortcutsItem)

        for subview in [header, tabView] {
            subview.translatesAutoresizingMaskIntoConstraints = false
            view.addSubview(subview)
        }

        NSLayoutConstraint.activate([
            header.topAnchor.constraint(equalTo: view.topAnchor, constant: Metrics.padding),
            header.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: Metrics.padding),
            header.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -Metrics.padding),
            header.heightAnchor.constraint(equalToConstant: 40),

            tabView.topAnchor.constraint(equalTo: header.bottomAnchor, constant: Metrics.rowSpacing),
            tabView.leadingAnchor.constraint(equalTo: view.leadingAnchor, constant: Metrics.padding),
            tabView.trailingAnchor.constraint(equalTo: view.trailingAnchor, constant: -Metrics.padding),
            // 底部也留出 padding：拒绝视觉死角
            tabView.bottomAnchor.constraint(equalTo: view.bottomAnchor, constant: -Metrics.padding),
        ])
    }

    // MARK: - 头部

    private func reloadHeader() {
        guard let scope else {
            iconView.image = nil
            nameLabel.stringValue = "未选择"
            detailLabel.stringValue = "在左侧选择一个应用"
            return
        }

        switch scope {
        case .global:
            if #available(macOS 11.0, *) {
                iconView.image = NSImage(systemSymbolName: "globe",
                                         accessibilityDescription: "全局")
            } else {
                iconView.image = NSWorkspace.shared.icon(forFileType: "app")
            }
            nameLabel.stringValue = scope.displayName
            detailLabel.stringValue = scope.subtitle
        case .app(let bundleIdentifier):
            let descriptor = AppDescriptor(bundleIdentifier: bundleIdentifier)
            iconView.image = descriptor.icon
            nameLabel.stringValue = descriptor.name
            detailLabel.stringValue = scope.subtitle
        }
    }
}
</file>

<file path="Sources/Stage4/UI/RuleItemEditorViewController.swift">
import AppKit
import Carbon.HIToolbox

/// 编辑某个 Touch Bar 按钮的「标题 / 颜色 / 动作」。
///
/// 改动会立即写回 `RuleStore`（落盘 + 通知后台注入引擎刷新），所以改完字马上能在触控栏上看到。
///
/// ## 第六阶段的排版重构
/// 之前这里把「marginally 宽度写死的 NSTextField」和「NSStackView 自动布局」混用，
/// 结果行高由 Auto Layout 猜、控件宽度互相覆盖 —— 这是底部区域重叠的根因。
/// 现在：
/// - 每一行都是 `FormRow`：标签列固定 92pt，控件列自适应，**行高是常量**；
/// - 动作部分整体交给 `ActionEditorView`（快捷键页复用同一组件）；
/// - 整个表单放在可滚动容器里（`makeFormBox`），窗口变矮只滚动、不裁切。
final class RuleItemEditorViewController: NSViewController, NSTextFieldDelegate {
    /// 编辑完成后通知父级刷新（带上被编辑按钮的 id，便于精确刷新那一行）
    var onDidEdit: ((String?) -> Void)?

    private var scope: RuleScope?
    private var itemID: String?

    // MARK: 控件

    private let titleField = NSTextField()
    private let colorWell = NSColorWell(frame: NSRect(x: 0, y: 0, width: 44, height: 24))
    private let actionEditor = ActionEditorView()

    private let titleRow: FormRow
    private let colorRow: FormRow

    private let emptyLabel = NSTextField(labelWithString: "在上方列表中选择（或新建）一个按钮后进行编辑")
    private let formLayout = VerticalFormLayout()
    private var formRows: [NSView] = []

    /// 颜色是否被用户碰过（区分「回显的占位色」与「用户真正选的颜色」）
    private enum ColorState {
        case untouched
        case changed(NSColor?)
    }
    private var colorState: ColorState = .untouched

    // MARK: - 生命周期

    init() {
        titleRow = FormRow(labelText: "显示文本", control: titleField)

        colorWell.translatesAutoresizingMaskIntoConstraints = false
        let clearButton = NSButton(title: "清除颜色", target: nil, action: nil)
        clearButton.bezelStyle = .roundRect
        let colorControls = NSStackView(views: [colorWell, clearButton])
        colorControls.orientation = .horizontal
        colorControls.alignment = .centerY
        colorControls.spacing = 12
        colorRow = FormRow(labelText: "背景颜色", control: colorControls)

        super.init(nibName: nil, bundle: nil)

        colorWell.target = self
        colorWell.action = #selector(colorDidChange(_:))
        clearButton.target = self
        clearButton.action = #selector(clearColor(_:))
    }

    required init?(coder: NSCoder) { fatalError("init(coder:) 未实现：纯代码布局") }

    override func loadView() {
        // 顶层容器会被当作 NSScrollView 的 documentView（见 makeFormBox）→ 必须是 flipped
        view = FlippedView()
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        buildUI()
        actionEditor.onDidEdit = { [weak self] in self?.commit() }
        edit(scope: nil, itemID: nil)
    }

    // MARK: - 对外接口

    func edit(scope: RuleScope?, itemID: String?) {
        // ⚠️ 必须在最前面强制加载视图：
        // 左栏 reload 时会在 `NSTableView.selectRowIndexes` 里同步抛通知，
        // 链条一路走到这里时，作为子控制器的我们可能**还没走过 viewDidLoad**
        // （子视图是懒加载的），此时 `stack` / `colorWell` 等控件全是 nil，
        // 访问隐式解包可选值会直接 SIGILL 崩溃（已在实机复现并修复）。
        // 注：AppKit 没有 UIKit 的 loadViewIfNeeded()，访问 `view` 即同步触发加载。
        _ = view

        self.scope = scope
        self.itemID = itemID

        guard let scope, let itemID,
              let model = RuleStore.shared.item(in: scope, itemID: itemID) else {
            showEmpty(true)
            return
        }
        showEmpty(false)

        let dto = ActionDTO(model.action)

        // 正在打字的控件不要回填（会把光标打断）
        if !isEditing(titleField) { titleField.stringValue = model.title }

        colorState = .untouched
        colorWell.color = model.bezelColor ?? .controlAccentColor

        actionEditor.configure(dto)
    }

    // MARK: - UI

    private func buildUI() {
        emptyLabel.translatesAutoresizingMaskIntoConstraints = false
        emptyLabel.textColor = .secondaryLabelColor
        view.addSubview(emptyLabel)
        NSLayoutConstraint.activate([
            emptyLabel.centerXAnchor.constraint(equalTo: view.centerXAnchor),
            emptyLabel.centerYAnchor.constraint(equalTo: view.centerYAnchor),
        ])

        titleField.bezelStyle = .roundedBezel
        titleField.delegate = self
        titleField.placeholderString = "按钮显示文本"

        colorWell.widthAnchor.constraint(equalToConstant: 44).isActive = true
        colorWell.heightAnchor.constraint(equalToConstant: Metrics.controlHeight).isActive = true

        // 显式等式链：宽度撑满、行高常量、整体高度 = 各行之和（不再依赖 NSStackView 猜）
        formRows = [titleRow, colorRow, actionEditor]
        formRows.forEach { view.addSubview($0) }
        formLayout.apply(rows: formRows, in: view)
    }

    private func showEmpty(_ empty: Bool) {
        emptyLabel.isHidden = !empty
        formRows.forEach { $0.isHidden = empty }
        if empty {
            formLayout.apply(rows: [], in: view)
        } else {
            formLayout.apply(rows: formRows, in: view)
        }
    }

    /// 该控件此刻是否正被用户编辑（NSTextField 编辑时 firstResponder 是 field editor）
    private func isEditing(_ control: NSView) -> Bool {
        guard let responder = view.window?.firstResponder as? NSView else { return false }
        if responder === control { return true }
        if let textView = responder as? NSTextView,
           let delegate = textView.delegate as AnyObject?,
           delegate === control {
            return true
        }
        return false
    }

    // MARK: - 写回模型

    private func commit() {
        guard let scope, let itemID,
              RuleStore.shared.item(in: scope, itemID: itemID) != nil else { return }

        let title = titleField.stringValue
        let explicitColor = colorState
        let dto = actionEditor.dto

        RuleStore.shared.updateItem(in: scope, itemID: itemID) { item in
            item.title = title.isEmpty ? "未命名" : title
            // 只有用户真的动过颜色才写回，避免「改个标题却凭空多出颜色」
            if case .changed(let color) = explicitColor {
                item.bezelColor = color
            }
            item.action = dto.action
        }

        // 立刻让右栏表格的那一行重绘（标题 + 色块即时变化）
        onDidEdit?(itemID)
    }

    // MARK: - Actions

    @objc private func colorDidChange(_ sender: NSColorWell) {
        colorState = .changed(sender.color)
        commit()
    }

    @objc private func clearColor(_ sender: Any) {
        guard let scope, let itemID else { return }
        colorState = .changed(nil)
        RuleStore.shared.updateItem(in: scope, itemID: itemID) { $0.bezelColor = nil }
        onDidEdit?(itemID)
    }

    func controlTextDidChange(_ obj: Notification) { scheduleCommit() }
    func controlTextDidEndEditing(_ obj: Notification) { commit() }

    // MARK: - 提交节流

    private var pendingCommit: DispatchWorkItem?

    private func scheduleCommit() {
        pendingCommit?.cancel()
        let work = DispatchWorkItem { [weak self] in
            self?.pendingCommit = nil
            self?.commit()
        }
        pendingCommit = work
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.25, execute: work)
    }
}
</file>

<file path="Sources/Stage4/UI/RuleListViewController.swift">
import AppKit
import UniformTypeIdentifiers

/// 左栏：作用域列表（「全局」 + 各应用规则） + 增/删按钮。
///
/// 列表的第一行固定是「全局（所有应用）」：
/// - 它的触控栏 = 未命中应用规则时的**兜底通用栏**；
/// - 它的快捷键 = **常驻全局**注册，不随前台应用切换。
final class RuleListViewController: NSViewController, NSTableViewDataSource, NSTableViewDelegate {
    /// 选中变化回调（把作用域 id 交给右栏）
    var onSelectScope: ((String?) -> Void)?

    /// 一行的展示数据（缓存图标与名字，避免每行都在绘制时查询 NSWorkspace）
    private struct Entry {
        let scopeID: String
        let name: String
        let icon: NSImage
    }

    private let tableView = NSTableView()
    private var entries: [Entry] = []
    private var storeObserver: NSObjectProtocol?

    private var selectedScopeID: String? {
        guard tableView.selectedRow >= 0, tableView.selectedRow < entries.count else { return nil }
        return entries[tableView.selectedRow].scopeID
    }

    // MARK: - 生命周期

    override func loadView() {
        view = NSView()
    }

    override func viewDidLoad() {
        super.viewDidLoad()
        buildUI()
        storeObserver = NotificationCenter.default.addObserver(
            forName: RuleStore.didChangeNotification, object: nil, queue: .main) { [weak self] _ in
                self?.reload(preservingSelection: true)
            }
        reload()
    }

    deinit {
        if let storeObserver { NotificationCenter.default.removeObserver(storeObserver) }
    }

    // MARK: - UI

    private func buildUI() {
        let addButton = makeIconButton(symbol: NSImage.addTemplateName,
                                       tooltip: "从 /Applications 选择一个 App 添加规则",
                                       target: self, action: #selector(addApplication(_:)))
        let removeButton = makeIconButton(symbol: NSImage.removeTemplateName,
                                          tooltip: "删除选中的应用规则",
                                          target: self, action: #selector(removeApplication(_:)))

        let bar = makeSectionBar(title: "作用域", controls: [addButton, removeButton])
        bar.edgeInsets = NSEdgeInsets(top: 0, left: 8, bottom: 0, right: 8)

        let column = NSTableColumn(identifier: NSUserInterfaceItemIdentifier(rawValue: "scopeColumn"))
        column.width = 240
        tableView.addTableColumn(column)
        tableView.headerView = nil
        tableView.rowHeight = 30
        tableView.dataSource = self
        tableView.delegate = self

        let scrollView = NSScrollView()
        scrollView.documentView = tableView
        scrollView.hasVerticalScroller = true
        scrollView.drawsBackground = false

        for subview in [bar, scrollView] {
            subview.translatesAutoresizingMaskIntoConstraints = false
            view.addSubview(subview)
        }
        NSLayoutConstraint.activate([
            bar.topAnchor.constraint(equalTo: view.topAnchor),
            bar.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            bar.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            bar.heightAnchor.constraint(equalToConstant: 34),

            scrollView.topAnchor.constraint(equalTo: bar.bottomAnchor),
            scrollView.leadingAnchor.constraint(equalTo: view.leadingAnchor),
            scrollView.trailingAnchor.constraint(equalTo: view.trailingAnchor),
            scrollView.bottomAnchor.constraint(equalTo: view.bottomAnchor),
        ])
    }

    // MARK: - 数据

    private func reload(preservingSelection: Bool = false) {
        let previous = selectedScopeID

        var result: [Entry] = [Entry(scopeID: RuleScope.global.id,
                                     name: "全局（所有应用）",
                                     icon: Self.globalIcon())]
        result.append(contentsOf: RuleStore.shared.rules.map { rule in
            let bundleID = rule.primaryBundleIdentifier
            let descriptor = AppDescriptor(bundleIdentifier: bundleID)
            return Entry(scopeID: RuleScope.app(bundleID).id,
                         name: descriptor.name,
                         icon: descriptor.icon)
        })
        entries = result
        tableView.reloadData()

        var targetIndex: Int? = nil
        if preservingSelection, let previous,
           let index = entries.firstIndex(where: { $0.scopeID == previous }) {
            targetIndex = index
        } else if !entries.isEmpty {
            targetIndex = 0
        }
        if let targetIndex {
            tableView.selectRowIndexes(IndexSet(integer: targetIndex), byExtendingSelection: false)
        }
        onSelectScope?(selectedScopeID)
    }

    private static func globalIcon() -> NSImage {
        if #available(macOS 11.0, *),
           let symbol = NSImage(systemSymbolName: "globe", accessibilityDescription: "全局") {
            return symbol
        }
        // 兜底：不查 NSWorkspace（避免 deprecated / 查询开销），直接用系统通用应用图标
        return NSImage(named: NSImage.applicationIconName) ?? NSImage()
    }

    // MARK: - Actions

    @objc private func addApplication(_ sender: Any) {
        guard let url = AppPicker.chooseApplication() else { return }

        // ① 先判定是不是真正的 .app 包（用户可能点到 Alias / 磁盘映像里的安装器）
        guard AppPicker.validate(url) else {
            AppPicker.showAlert(message: "这不是一个有效的应用程序包",
                                informative: "请选择一个扩展名为 .app 的应用；如果是替身（Alias），请先「显示原身」再选取。")
            return
        }

        // ② 读取 Bundle ID 失败要给出友好提示（常见于损坏/未签名的包）
        guard let bundle = Bundle(url: url), let bundleIdentifier = bundle.bundleIdentifier,
              !bundleIdentifier.isEmpty else {
            AppPicker.showAlert(message: "无法读取该应用的 Bundle Identifier",
                                informative: "“\(url.lastPathComponent)” 的包信息不完整，btTool 无法为其建立规则。")
            return
        }

        let name = bundle.infoDictionary?["CFBundleDisplayName"] as? String
            ?? bundle.infoDictionary?["CFBundleName"] as? String
            ?? FileManager.default.displayName(atPath: url.path)

        // ③ 重复添加：不静默失败 —— 弹提示，并把已存在的那条选中 + 滚动可见（视觉提示）
        guard RuleStore.shared.addRule(bundleIdentifier: bundleIdentifier, preferredName: name) else {
            AppPicker.showAlert(message: "“\(name)” 已经在列表中",
                                informative: "已为你选中并高亮这条规则，直接在右侧编辑即可。")
            highlight(scopeID: RuleScope.app(bundleIdentifier).id)
            return
        }

        highlight(scopeID: RuleScope.app(bundleIdentifier).id)
    }

    /// 选中并滚动到指定条目（新添加 / 已存在时都用它做视觉反馈）
    private func highlight(scopeID: String) {
        reload(preservingSelection: false)
        guard let index = entries.firstIndex(where: { $0.scopeID == scopeID }) else { return }
        tableView.selectRowIndexes(IndexSet(integer: index), byExtendingSelection: false)
        tableView.scrollRowToVisible(index)
        view.window?.makeFirstResponder(tableView)
        onSelectScope?(scopeID)
    }

    @objc private func removeApplication(_ sender: Any) {
        guard let scopeID = selectedScopeID else { return }
        let scope = RuleScope(id: scopeID)
        guard !scope.isGlobal else {
            AppPicker.showAlert(message: "「全局」作用域不能删除",
                                informative: "它承载了兜底触控栏与常驻全局的快捷键；如果不需要，清空里面的条目即可。")
            return
        }
        guard let bundleIdentifier = scope.bundleIdentifier else { return }
        RuleStore.shared.removeRule(bundleIdentifier: bundleIdentifier)
    }

    // MARK: - NSTableViewDataSource / Delegate

    func numberOfRows(in tableView: NSTableView) -> Int { entries.count }

    func tableView(_ tableView: NSTableView, viewFor tableColumn: NSTableColumn?, row: Int) -> NSView? {
        let identifier = NSUserInterfaceItemIdentifier(rawValue: "IconTitleCell")
        let cell: IconTitleCellView
        if let reused = tableView.makeView(withIdentifier: identifier, owner: self) as? IconTitleCellView {
            cell = reused
        } else {
            cell = IconTitleCellView(frame: .zero)
            cell.identifier = identifier
        }
        let entry = entries[row]
        cell.configure(icon: entry.icon, title: entry.name)
        return cell
    }

    func tableViewSelectionDidChange(_ notification: Notification) {
        onSelectScope?(selectedScopeID)
    }
}

// MARK: - /Applications 选取 + 提示框

enum AppPicker {
    static func chooseApplication() -> URL? {
        let panel = NSOpenPanel()
        panel.canChooseFiles = true
        panel.canChooseDirectories = false
        panel.allowsMultipleSelection = false
        panel.resolvesAliases = true
        panel.message = "选择一个要添加规则的应用"
        panel.prompt = "添加"
        panel.directoryURL = URL(fileURLWithPath: "/Applications")
        if #available(macOS 11.0, *) {
            panel.allowedContentTypes = [.application]
        } else {
            panel.allowedFileTypes = ["app"]
        }
        return panel.runModal() == .OK ? panel.url : nil
    }

    /// 基本合法性校验：必须是目录形态的 bundle，且包内有 Info.plist / Contents 结构
    static func validate(_ url: URL) -> Bool {
        var isDirectory: ObjCBool = false
        guard FileManager.default.fileExists(atPath: url.path, isDirectory: &isDirectory),
              isDirectory.boolValue else { return false }
        return url.pathExtension.lowercased() == "app"
            && FileManager.default.fileExists(atPath: url.appendingPathComponent("Contents/Info.plist").path)
    }

    static func showAlert(message: String, informative: String = "") {
        let alert = NSAlert()
        alert.alertStyle = .warning
        alert.messageText = message
        alert.informativeText = informative
        alert.runModal()
    }
}
