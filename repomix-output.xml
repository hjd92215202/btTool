import AppKit

/// 一行标准的「右对齐标签 + 控件」表单行。
///
/// ## 为什么手写约束而不用 NSStackView
/// 之前用 `NSStackView` 拼每行，再塞进一个纵向 stack 里：父 stack 用 `alignment: .leading`
/// 时行宽取决于子视图 intrinsic width，而多个控件的 intrinsic 与固定宽度常量打架，
/// 最终谁飘到哪全看 Auto Layout 的优先级推理结果 —— 这就是「控件重叠」的根因。
///
/// 现在这一行的几何关系被**完全钉死**：
///
/// ```
/// leading ──[label 宽 92]── 12pt ──[control]── trailing
/// 垂直方向：control 居中，行高 = controlHeight + 6（脚本行 = scriptHeight + 6）
/// ```
///
/// 于是「每行的左边缘一定对齐」「行高一定是已知常量」，
/// 容器就能精确算出自己的高度，不需要 Auto Layout 去猜。
final class FormRow: NSView {
    let label: NSTextField
    let control: NSView

    /// 行高（容器靠它精确计算自己的高度）
    let rowHeight: CGFloat

    /// - Parameters:
    ///   - labelText: 标签文案（之后可以直接改 `row.label.stringValue`）
    ///   - control: 控件
    ///   - controlHeight: 控件高度；决定这一行的高度
    init(labelText: String,
         control: NSView,
         controlHeight: CGFloat = Metrics.controlHeight) {
        self.control = control
        self.rowHeight = controlHeight + 6

        let textField = NSTextField(labelWithString: labelText)
        textField.translatesAutoresizingMaskIntoConstraints = false
        textField.alignment = .right
        textField.font = NSFont.systemFont(ofSize: 12)
        textField.textColor = .labelColor
        textField.lineBreakMode = .byTruncatingTail
        // ⚠️ 不要把 hugging / compression 设成 .required：
        //    那会生成「宽度 == intrinsic(96)」/「宽度 >= intrinsic」的必需约束，
        //    和下面写死的 92pt 宽度等式直接打架，AppKit 会静默拆掉宽度约束，
        //    实测标签会左右各溢 2pt。这里保持默认优先级，让显式宽度说了算。
        self.label = textField

        super.init(frame: .zero)

        translatesAutoresizingMaskIntoConstraints = false
        control.translatesAutoresizingMaskIntoConstraints = false

        addSubview(textField)
        addSubview(control)

        NSLayoutConstraint.activate([
            // 标签：固定宽度，紧贴左边缘
            textField.leadingAnchor.constraint(equalTo: leadingAnchor),
            textField.widthAnchor.constraint(equalToConstant: Metrics.labelWidth),
            textField.centerYAnchor.constraint(equalTo: centerYAnchor),

            // 控件：紧跟标签之后 12pt，右边缘贴住父视图 —— 宽度自适应，不写死
            control.leadingAnchor.constraint(equalTo: textField.trailingAnchor,
                                             constant: Metrics.labelGap),
            control.trailingAnchor.constraint(equalTo: trailingAnchor),
            control.heightAnchor.constraint(equalToConstant: controlHeight),
            control.centerYAnchor.constraint(equalTo: centerYAnchor),

            // 行高固定，这样外层容器可以精确算高
            heightAnchor.constraint(equalToConstant: rowHeight),
        ])
    }

    required init?(coder: NSCoder) { fatalError("init(coder:) 未实现：纯代码布局") }
}
</file>

<file path="Sources/Stage4/UI/MainMenuBuilder.swift">
import AppKit

/// 程序化构建主菜单栏。
///
/// accessory 应用（LSUIElement）默认没有主菜单 —— 一旦我们把策略切成 `.regular`，
/// 窗口就会缺少主菜单，导致：⌘W 关不掉窗口、文本框里 ⌘C/⌘V 失效、没有「窗口」菜单。
/// 这里按标准结构（App / Edit / Window）手工搭一个，所有 action 都指向 nil target
/// （走 responder chain），因此无需我们自己实现任何逻辑。
enum MainMenuBuilder {
    static func installIfNeeded() {
        guard NSApp.mainMenu == nil else { return }

        let mainMenu = NSMenu()

        // — App 菜单 —
        let appMenuItem = NSMenuItem(title: "btTool", action: nil, keyEquivalent: "")
        let appMenu = NSMenu()
        appMenu.addItem(withTitle: "关于 btTool",
                        action: #selector(NSApplication.orderFrontStandardAboutPanel(_:)),
                        keyEquivalent: "")
        appMenu.addItem(.separator())
        appMenu.addItem(withTitle: "隐藏 btTool", action: #selector(NSApplication.hide(_:)), keyEquivalent: "h")
        appMenu.addItem({ item in
            item.title = "隐藏其他"
            item.action = #selector(NSApplication.hideOtherApplications(_:))
            item.keyEquivalent = "h"
            item.keyEquivalentModifierMask = [.command, .option]
            return item
        }(NSMenuItem()))
        appMenu.addItem(.separator())
        appMenu.addItem(withTitle: "退出 btTool", action: #selector(NSApplication.terminate(_:)), keyEquivalent: "q")
        appMenuItem.submenu = appMenu
        mainMenu.addItem(appMenuItem)

        // — Edit 菜单（决定文本框能否 ⌘X/⌘C/⌘V）—
        let editMenuItem = NSMenuItem(title: "编辑", action: nil, keyEquivalent: "")
        let editMenu = NSMenu(title: "编辑")
        editMenu.addItem(menuItem("撤销", #selector(UndoAction.undo(_:)), "z"))
        editMenu.addItem(menuItem("重做", #selector(UndoAction.redo(_:)), "Z"))
        editMenu.addItem(.separator())
        editMenu.addItem(menuItem("剪切", #selector(NSText.cut(_:)), "x"))
        editMenu.addItem(menuItem("拷贝", #selector(NSText.copy(_:)), "c"))
        editMenu.addItem(menuItem("粘贴", #selector(NSText.paste(_:)), "v"))
        editMenu.addItem(menuItem("全选", #selector(NSText.selectAll(_:)), "a"))
        editMenuItem.submenu = editMenu
        mainMenu.addItem(editMenuItem)

        // — Window 菜单 —
        let windowMenuItem = NSMenuItem(title: "窗口", action: nil, keyEquivalent: "")
        let windowMenu = NSMenu(title: "窗口")
        windowMenu.addItem(menuItem("最小化", #selector(NSWindow.performMiniaturize(_:)), "m"))
        windowMenu.addItem(menuItem("缩放", #selector(NSWindow.performZoom(_:)), ""))
        windowMenu.addItem(.separator())
        windowMenu.addItem(menuItem("关闭窗口", #selector(NSWindow.performClose(_:)), "w"))
        windowMenuItem.submenu = windowMenu
        mainMenu.addItem(windowMenuItem)
        NSApp.windowsMenu = windowMenu

        NSApp.mainMenu = mainMenu
        Log.info("已构建程序化主菜单")
    }

    private static func menuItem(_ title: String, _ action: Selector, _ key: String) -> NSMenuItem {
        NSMenuItem(title: title, action: action, keyEquivalent: key)
    }
}

/// `#selector(UndoAction.undo(_:))` 需要一个真实存在的类型
@objc protocol UndoAction {
    @objc func undo(_ sender: Any?)
    @objc func redo(_ sender: Any?)
}
